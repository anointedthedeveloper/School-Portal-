# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000
# Local MongoDB or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/school_portal
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Refresh-token cookie SameSite policy. Use 'none' (requires HTTPS) only if frontend and API are on different sites.
COOKIE_SAME_SITE=lax
# Optional. If set, the seed script uses it as the secret for the CBT Exam Box integration client.
CBT_API_KEY=
# Optional. Overrides the development seed password for all seeded users (dev only).
SEED_PASSWORD=
LOG_LEVEL=info
